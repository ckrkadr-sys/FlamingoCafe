---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { menu, chip, groups } from '../data/menu';
import { photo, cutouts } from '../data/photos';

const altFor = (name: string, fallback: string) => {
  for (const s of menu) for (const i of s.items) if (i.photo === name) return i.desc ? `${i.tr}: ${i.desc.toLowerCase()}` : i.tr;
  return fallback;
};
const total = menu.reduce((n, s) => n + s.items.length, 0);
// Full-size view for the thumbnail dialog: built here, fetched only when the dialog opens.
const thumbs = new Set(menu.flatMap((s) => s.items.filter((i) => i.photo && i.photo !== s.photo).map((i) => i.photo!)));
const full = Object.fromEntries(await Promise.all([...thumbs].map(async (p) => [p, await getImage({ src: photo(p), width: 900, format: 'webp' })])));
---
<Base
  title="Menü"
  current="menu"
  description="Flamingo Cafe & Bistro menüsü: gün boyu kahvaltı, tost, burger, makarna, kase, tatlı, kahve, bira, şarap ve kokteyller. Türkçe ve İngilizce."
>
  <section class="mhero wrap" aria-labelledby="menu-title">
    <div class="grid">
      <h1 id="menu-title" class="mhero__title display" data-split="chars" data-intro>Menü</h1>
      <div class="mhero__text" data-reveal="up" data-intro data-delay="0.3">
        <p><strong>{menu.length} bölüm, {total} çeşit.</strong> Kahvaltı gün boyu servis edilir. Fiyatları ekibimize sorabilirsiniz.</p>
        <p class="muted">Sayfa, sabah kahvaltısından gece kokteyline doğru ilerliyor ve indikçe pembeleşiyor. Flamingo gibi: ne kadar yerseniz o kadar.</p>
      </div>
    </div>
  </section>

  <nav class="chips" aria-label="Menü bölümleri" data-chips data-active={groups[0].id}>
    <ul class="chips__groups">
      {groups.map((g) => <li><a href={`#${g.ids[0]}`} data-group={g.id}>{g.label}</a></li>)}
    </ul>
    {groups.map((g) => (
      <ul class="chips__row" data-row={g.id} aria-label={g.label} hidden={g !== groups[0]}>
        {g.ids.map((id) => <li><a href={`#${id}`} data-chip={id}><span class="dip"><span>{chip[id]}</span><span aria-hidden="true">{chip[id]}</span></span></a></li>)}
      </ul>
    ))}
  </nav>

  {menu.map((s, n) => (
    <section id={s.id} class:list={['msec wrap', { 'msec--plain': !s.photo }]} aria-labelledby={`${s.id}-t`} data-section data-in={groups.find((g) => g.ids.includes(s.id))!.id}>
      <div class="grid">
        <div class="msec__head">
          <h2 id={`${s.id}-t`} class="msec__title display">{s.tr}</h2>
          {s.en !== s.tr && <span class="msec__en" lang="en">{s.en}</span>}
        </div>
        {s.note && <p class="msec__note">{s.note}</p>}
        {s.photo && (
          <figure class:list={['msec__photo', { 'msec__photo--cutout': cutouts.has(s.photo) }]}>
            <Image src={photo(cutouts.has(s.photo) ? `${s.photo}-cutout` : s.photo)} alt={altFor(s.photo, s.tr)} format="webp" widths={[480, 800, 1100]} sizes="(max-width: 767px) calc(100vw - 2rem), 40vw" loading={n === 0 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : undefined} />
          </figure>
        )}
        <ul class="items">
          {s.items.map((i) => (
            <li class:list={['item', { 'item--thumb': i.photo && i.photo !== s.photo }]}>
              <h3>{i.tr}{i.en && <span class="en" lang="en"> / {i.en}</span>}</h3>
              {i.desc && <p>{i.desc}</p>}
              {i.photo && i.photo !== s.photo && (
                <button class:list={['item__zoom', { 'item__zoom--cutout': cutouts.has(i.photo) }]} type="button" aria-label={`${i.tr} görselini büyüt`} data-full={full[i.photo].src} data-alt={i.tr} data-w={full[i.photo].attributes.width} data-h={full[i.photo].attributes.height}>
                  {cutouts.has(i.photo)
                    ? <Image src={photo(`${i.photo}-cutout`)} alt="" widths={[112, 160, 224]} sizes="(max-width: 767px) 80px, 112px" format="webp" loading="lazy" />
                    : <Image src={photo(i.photo)} alt="" width={224} height={224} widths={[112, 160, 224]} sizes="(max-width: 767px) 80px, 112px" format="webp" loading="lazy" />}
                </button>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <dialog class="zoom" aria-label="Yemek görseli" data-zoom>
    <button class="zoom__close" type="button" aria-label="Kapat" data-zoom-close><span aria-hidden="true">×</span></button>
    <img alt="" />
  </dialog>

  <section class="mend wrap" aria-labelledby="end-title">
    <h2 id="end-title" class="mend__big display">Gün battı, sıra sizde.</h2>
    <p>Masanızı ayırtmak ya da bir şey sormak için arayın. Instagram’dan da yazabilirsiniz: <a class="link" href={site.instagram.href} rel="noopener">{site.instagram.handle}</a></p>
    <a class="btn btn--solid" href={`tel:${site.tel}`}>Ara: {site.phone}</a>
  </section>
</Base>
